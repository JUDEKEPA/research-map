{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Research analysis node",
  "type": "object",
  "required": [
    "id",
    "title",
    "description",
    "storage",
    "code",
    "data",
    "figures",
    "documents",
    "relationships"
  ],
  "properties": {
    "id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "description": {
      "type": "string"
    },
    "storage": {
      "type": "object",
      "required": [
        "folders"
      ],
      "properties": {
        "folders": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "code": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "data": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "figures": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "documents": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "other": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "relationships": {
      "type": "array",
      "items": {
        "type": "object"
      }
    },
    "evidence": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "provenance": {
      "type": "object"
    }
  },
  "additionalProperties": true
}